

Q       BIT   P1.1
U       BIT   P0.0
V       BIT   P0.1
W       BIT   P0.2
X       BIT   P0.3
Z       BIT   P0.4
A1	BIT	P0.5
B1	BIT   P0.6
C1      BIT   P0.7
F1	BIT PSW.1


        ORG   0H
        CLR Q
        CLR U
        CLR V
        CLR W
        CLR X
        CLR Z
        CLR A1
        CLR B1
        CLR C1
START:

        MOV   C, W
        ANL   C, V
        MOV   F0, C

        MOV   C, X
        ANL   C, /Z
        ORL   C, F0
        MOV   F0, C

        MOV   C, A1
        ORL   C, C1
        MOV   F1, C

        MOV   C, U
        ORL   C, B1
        ANL   C, F1

        ORL   C, F0
        MOV   Q, C

        CPL   Q
        JMP  START
        END

